# PostgreSQL Settings
POSTGRES_USER=honeypot_user
POSTGRES_PASSWORD=honeypot_pass
POSTGRES_DB=honeypot_db

# Backend Database URL
# For local SQLite testing (default if not set):
# DATABASE_URL=sqlite:///./data/dev.db
# For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://honeypot_user:honeypot_pass@127.0.0.1:5432/honeypot_db

# Model Mode: auto, real, synthetic
MODEL_MODE=auto

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
